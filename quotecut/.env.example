# Copy to .env.local and fill in.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Public site URL (no trailing slash). Used for magic-link redirects & share links ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domain shown in the copy-link button (display only)
NEXT_PUBLIC_SITE_DOMAIN=quotecut.app

# --- AI provider: "google" or "openai" ---
AI_PROVIDER=google
# Optional model override (defaults: gemini-2.5-flash / gpt-4o-mini)
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# --- Lemon Squeezy checkout URL for Pro ($9/mo). Leave blank to show a placeholder ---
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=

# --- Billing webhook (server only; NEVER prefix with NEXT_PUBLIC_) ---
# Supabase -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Lemon Squeezy -> Settings -> Webhooks -> signing secret
LEMONSQUEEZY_WEBHOOK_SECRET=

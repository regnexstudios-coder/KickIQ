{
  "expo": {
    "name": "KickIQ",
    "slug": "kickiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kickiq",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0F0C",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.kickiq.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "KickIQ needs photo library access so you can import a clip of your kick to rate.",
        "UIBackgroundModes": []
      },
      "associatedDomains": ["applinks:kickiq.app"]
    },
    "android": {
      "package": "com.kickiq.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0F0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "kickiq.app", "pathPrefix": "/rate" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "output": "static", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-video",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0F0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "KickIQ uses the camera to film your kick so it can be rated.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "KickIQ records sound with your kick video.",
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KickIQ needs photo library access so you can import a clip of your kick to rate."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "16.4" },
          "android": { "minSdkVersion": 26 }
        }
      ]
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true },
    "extra": { "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" } }
  }
}
